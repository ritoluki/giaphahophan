{
  "name": "phan-gia-pha-agent-kit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "pnpm --filter @phan/web dev",
    "dev:worker": "pnpm --filter @phan/worker dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @phan/domain test",
    "test:db": "node scripts/test-db-local.mjs",
    "test:jobs": "node scripts/test-jobs-local.mjs",
    "test:m11:delivery": "node scripts/test-m11-delivery-local.mjs",
    "test:m03": "node scripts/test-m03-local.mjs",
    "test:m03:dates": "node scripts/test-m03-dates-local.mjs",
    "test:m03:claims": "node scripts/test-m03-claims-local.mjs",
    "test:m03:delete": "node scripts/test-m03-delete-local.mjs",
    "test:concurrency": "node scripts/test-concurrency-local.mjs",
    "test:auth": "node scripts/test-auth-local.mjs",
    "test:integration": "node scripts/status-not-run.mjs test:integration",
    "test:e2e": "pnpm build && pnpm exec playwright test",
    "test:a11y": "node scripts/status-not-run.mjs test:a11y",
    "test:visual": "pnpm build && pnpm exec playwright test --project=desktop-chromium --project=mobile-chromium --project=mobile-320",
    "test:load": "node scripts/status-not-run.mjs test:load",
    "build": "pnpm --filter @phan/web build",
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/release-check.mjs",
    "db:migrate:local": "node scripts/status-not-run.mjs db:migrate:local",
    "seed:demo": "node scripts/status-not-run.mjs seed:demo",
    "seed:benchmark": "node scripts/status-not-run.mjs seed:benchmark",
    "backup:check": "node scripts/status-not-run.mjs backup:check",
    "restore:verify": "node scripts/status-not-run.mjs restore:verify",
    "test:m04:graph": "node scripts/test-m04-graph-local.mjs",
    "test:m04:cycle": "node scripts/test-m04-cycle-concurrency-local.mjs",
    "test:m05:kinship": "node scripts/test-m05-kinship-local.mjs",
    "test:m06:search": "node scripts/test-m06-search-local.mjs",
    "test:m06:http": "node scripts/test-m06-search-http-local.mjs",
    "test:m06:load": "node scripts/test-m06-search-load-local.mjs",
    "test:m07:invitations": "node scripts/test-m07-invitations-local.mjs",
    "test:m07:session": "node scripts/test-m07-session-local.mjs",
    "test:m07:mfa": "node scripts/test-auth-local.mjs",
    "test:m07:membership": "node scripts/test-m07-membership-local.mjs",
    "test:m07:recovery": "node scripts/test-m07-recovery-local.mjs",
    "test:m08:proposal": "node scripts/test-m08-proposal-local.mjs",
    "test:m09:media": "node scripts/test-m09-media-local.mjs",
    "test:m09:sources": "node scripts/test-m09-sources-local.mjs",
    "test:m09:links": "node scripts/test-m09-links-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "fast-check": "4.3.0",
    "jsdom": "26.1.0",
    "supabase": "2.118.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
